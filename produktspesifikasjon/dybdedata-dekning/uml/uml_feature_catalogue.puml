@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Dybdedata - dekning - UML - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  class FiktivDelelinje <<featureType>> {
    + grense [1] : Kurve
  }

  class Slipp <<featureType>> {
    + grense [1] : Kurve
  }

  class Datakvalitetgrense <<featureType>> {
    + grense [1] : Kurve
  }

  class Utstikker <<featureType>> {
    + senterlinje [1] : Kurve
  }

  class Flytedokk <<featureType>> {
    + område [1] : Flate
  }

  abstract class FellesegenskaperFiktivDelelinje <<featureType>> {
    + identifikasjon [1] : Identifikasjon
    + førsteDatafangstdato [0..1] : Date
    + oppdateringsdato [0..1] : Date
    + datauttaksdato [1] : Date
    + kvalitet [0..1] : Posisjonskvalitet
  }

  class "Tørrdokk" as T_rrdokk <<featureType>> {
    + område [1] : Flate
  }

