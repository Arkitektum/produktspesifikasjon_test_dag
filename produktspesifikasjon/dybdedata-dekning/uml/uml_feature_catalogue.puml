  class "Tørrfall" as T_rrfall <<featureType>> {
    + område [1] : Flate
  }

  class Dybdepunkt <<featureType>> {
    + posisjon [1] : Punkt
    + dybde [1] : Real
    + dybdetype [0..1] : Dybdetype
  }

  class Rampe <<featureType>> {
