@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Dybdedata - dekning - Ny datakilde2 - InfraGML_Part4_Road

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "InfraGML_Part4_Road" {

  abstract class VegElement <<featureType>> {
    + fraProfil [0..1] : Real
    + tilProfil [0..1] : Real
    + norskeTillegg [0..1] : VegElementNorskeTillegg
  }

  class Veg <<featureType>> {
    + norskeTillegg [0..1] : VegNorskeTillegg
  }

  abstract class RoadElementN <<featureType>> {
    + roadElementID [1] : ID
    + material [0..1] : CharacterString
  }

  class VegElementNorskeTillegg <<dataType>> {
    + tilhørerProsjekt [0..1] : Prosjektreferanse
    + komponentreferanse [0..*] : Komponentreferanse
  }

  class Prosjektreferanse <<dataType>> {
    + oppdragsgiverNavn [1] : CharacterString
    + oppdragsgiversOrganisasjonsnummer [0..1] : CharacterString
    + prosjektnavn [1] : CharacterString
    + prosjektID [1] : CharacterString
    + prosjektfase [0..1] : CharacterString
    + fasestatus [0..1] : CharacterString
    + levertAvOrganisasjon [1] : CharacterString
    + utarbeidetAv [1] : CharacterString
    + prosjektURL [0..1] : CharacterString
    + leveransedato [1] : Date
  }

  class Komponentreferanse <<dataType>> {
    + komponentkodesystem [1] : Komponentkodesystem
    + kodesystemversjon [1] : CharacterString
    + komponentkodeverdi [1] : CharacterString
  }

  class VegNorskeTillegg <<dataType>> {
    + tilhørerProsjekt [0..1] : Prosjektreferanse
    + komponentReferanse [0..*] : Komponentreferanse
    + dimensjonerendeParametre [0..1] : DimensjonerendeVerdier_Veg
    + totalOverbygningstykkelse [0..1] : Real
  }

  class DimensjonerendeVerdier_Veg <<dataType>> {
    + standardklasseVegstandard [1] : Dimensjoneringsklasse
    + hastighet [1] : DimensjonerendeHastighet
    + vegbredde [1] : DimensjonerendeVegbredde
    + motorkjøretøy [1] : DimensjonerendeMotorkjøretøy
    + trafikkmengdeÅDT [1] : DimensjonerendeTrafikkmengdeÅDT
    + kjøremåte [1] : DimensjonerendeKjøremåte
    + maxOverhøydeProsent [1] : MaxOverhøydeProsent
    + trafikk [1] : DimensjonerendeTrafikkgruppe
  }
}

package "Eksterne referanser" <<Frame>> {
  class PhysicalElement <<Facility_GML>> {
  }
  class Referanselinje <<InfraGML_Part3_Alignment>> {
  }
  class Road <<Part4_Road>> {
  }
}

RoadElementN <|-- VegElement
Road <|-- Veg
Veg --> Referanselinje : referanselinje [0..*]
Veg --> VegElement : element [0..*]
PhysicalElement <|-- RoadElementN

@enduml
