@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Dybdedata - dekning - Ny datakilde2 - Arealformål

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Arealformål" {

  class "RbFormålOmråde" as RbForm_lOmr_de <<featureType>> {
    + område [1] : Flate
    + reguleringsformål [1] : RegformBrukFormål
    + reguleringsformålsutdyping [0..1] : CharacterString
    + feltbetegnelse [0..1] : CharacterString
    + utnytting [0..1] : Utnytting
    + uteoppholdsareal [0..1] : Integer
    + byggverkbestemmelse [0..1] : Byggverkbestemmelse
    + avkjørselsbestemmelse [0..1] : Avkjørselsbestemmelse
  }

  class "RpFormålGrense" as RpForm_lGrense <<featureType>> {
    + grense [1] : Kurve
  }

  class "RpArealformålOmråde" as RpArealform_lOmr_de <<featureType>> {
    + område [1] : Flate
    + arealformål [1] : RpArealformål
    + eierform [1] : EierformType
    + utnytting [0..1] : Utnytting
    + beskrivelse [0..1] : CharacterString
    + feltbetegnelse [0..1] : CharacterString
    + uteoppholdsareal [0..1] : Integer
    + byggverkbestemmelse [0..1] : Byggverkbestemmelse
    + avkjørselsbestemmelse [0..1] : Avkjørselsbestemmelse
  }

  class Utnytting <<dataType>> {
    + utnyttingstype [1] : Utnyttingstype
    + utnyttingstall [0..1] : Real
    + utnyttingstall_minimum [0..1] : Real
  }
}

package "Eksterne referanser" <<Frame>> {
  class "RpOmråde" as RpOmr_de <<Planområde>> {
  }
  class "SOSI_Objekt_Plandelområde_Rp" as SOSI_Objekt_Plandelomr_de_Rp <<SOSI_Objekt_Rp>> {
  }
  class SOSI_Objekt_Planlinjer_Rp <<SOSI_Objekt_Rp>> {
  }
}

SOSI_Objekt_Plandelomr_de_Rp <|-- RbForm_lOmr_de
RbForm_lOmr_de --> RpOmr_de : [1]
RbForm_lOmr_de --> RpForm_lGrense : avgrensning [0..*]
SOSI_Objekt_Planlinjer_Rp <|-- RpForm_lGrense
RpForm_lGrense --> RbForm_lOmr_de : [1..2]
RpForm_lGrense --> RpArealform_lOmr_de : [0..*]
SOSI_Objekt_Plandelomr_de_Rp <|-- RpArealform_lOmr_de
RpArealform_lOmr_de --> RpOmr_de : [1]
RpArealform_lOmr_de --> RpForm_lGrense : avgrensning [1..*]

@enduml
