AnyFeature <|-- Feature
Feature --> PropertySet : propertySet [0..*]
Feature --> PropertySet : propertySet [0..*]
Feature --> Property : property [0..*]
Feature --> Property : property [0..*]
Feature <|-- PhysicalElement
PhysicalElement --> PhysicalElement : part [0..*]
PhysicalElement --> PhysicalElement : partOf [0..1]
Feature <|-- Facility
Feature <|-- FacilityPart
FacilityPart --> Facility
FacilityPart --> FacilityPartRelationship : relationship [0..*]
Feature <|-- Alignment
FacilityPart <|-- Road
Road --> Alignment : alignment [0..*]
Road --> RoadElementSet : roadElementSet [0..*]
Road --> StringLine : stringLine [0..*]
Road --> StringLineSet : stringLineSet [0..*]
Road --> CrossSection : crossSection [0..*]
Road --> RoadElement : element [0..*]
PhysicalElement <|-- RoadElement
RoadElement --> LinearElement : locatedAlong [0..1]
RoadElement --> RoadElementSet
Feature <|-- AbstractFeature
AbstractFeature --> AbstractFeature : part [0..*]
AbstractFeature --> AbstractFeature : partOf [0..1]
Alignment --> AlignmentCurve : geometry [0..1]
Alignment <|-- Referanselinje
RoadElementN <|-- VegElement
Road <|-- Veg
Veg --> Referanselinje : referanselinje [0..*]
Veg --> VegElement : element [0..*]
PhysicalElement <|-- RoadElementN
VegElement <|-- VegdesignElement
VegdesignElement --> Overbygningselement_for_Vegdesign : overbygning [0..*]
VegdesignElement --> Underbygning : underbygning [0..*]
VegdesignElement --> Planum : planum [0..*]
VegkroppElement <|-- Planum
Planum --> YtreFlatekant : venstreSide [0..1]
Planum --> YtreFlatekant : høyreSide [0..1]
VegkroppElement <|-- Overbygning
Overbygning --> VegdesignElement : vegdesignElement [0..1]
VegElement <|-- VegkroppElement
VegkroppElement --> Volumobjekt : volum [0..1]
VegkroppElement --> ToppOverflate : toppOverflate [0..1]
VegkroppElement --> YtreFlatekant : ytterkant [0..1]
VegkroppElement <|-- Underbygning
VegkroppElement <|-- Sideomr_de
Sideomr_de --> VegdesignElement : vegdesignElement [0..1]
GenerelleEgenskaper <|-- Vegkropp
Vegkropp --> VegKroppElement : vegkroppElement [0..*]
GenerelleEgenskaper <|-- Veg_Prosjektreferanse
Veg_Prosjektreferanse --> Vegkropp : vegelementsamling [0..*]
Veg_Prosjektreferanse --> VegKroppElement : element [0..*]
Veg_Prosjektreferanse --> StringLineN : stringLine [0..*]
StringLineN <|-- StringLineN_Planum
StringLineN <|-- StringLineN_Referanselinje
StringLineN <|-- StringLineN_Underbygning
GenerelleEgenskaper <|-- StringLineN
StringLineN <|-- StringLineN_Sideomr_de
StringLineN <|-- StringLineN_Overbygning
GenerelleEgenskaper <|-- VegdesignElement_for_Vegkropp
VegKroppElement <|-- Planum
Planum --> YtreFlatekant : høyreSide [0..1]
Planum --> YtreFlatekant : venstreSide [0..1]
GenerelleEgenskaper <|-- VegKroppElement
VegKroppElement --> ToppOverflate : toppOverflate [0..1]
VegKroppElement --> YtreFlatekant : ytterkant [0..1]
VegKroppElement --> Volumobjekt : volum [0..1]
VegKroppElement <|-- Underbygning
VegKroppElement <|-- Overbygning
Overbygning --> VegdesignElement_for_Vegkropp : vegdesignElement [0..1]
VegKroppElement <|-- Sideomr_de
Sideomr_de --> VegdesignElement_for_Vegkropp : vegdesignElement [0..1]
GenerelleEgenskaper <|-- Terrengflate
AlignmentSet --> Alignment : alignment [1..*]
AlignmentSet --> Alignment : alignment [1..*]
Element --> FacilityPart
Railway --> Alignment : alignment [0..*]
SuperelevationEvent --> Alignment : locatedAlong [1]
TemplateLocation --> Alignment : locatedAlong [1]

@enduml
