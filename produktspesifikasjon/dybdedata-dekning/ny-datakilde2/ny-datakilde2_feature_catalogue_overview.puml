class AlignmentSet <<featureType>> {
}
class CrossSection <<featureType>> {
}
class Element <<featureType>> {
}
class Property <<featureType>> {
}
class PropertySet <<featureType>> {
}
class Railway <<featureType>> {
}
class RoadElementSet <<featureType>> {
}
class StringLineSet <<featureType>> {
}
