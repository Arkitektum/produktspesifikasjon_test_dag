@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Dybdedata - dekning - Ny datakilde2 - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  class Feature <<featureType>> {
    + name [0..1] : CharacterString
    + description [0..1] : CharacterString
    + spatialRepresentation [0..*] : SpatialRepresentation
    + linearlyReferencedLocation [0..*] : LinearlyReferencedLocation
  }

  class LandSurface <<featureType>> {
    + spatialRepresentation [1] : TIN
    + material [0..1] : CharacterString
  }

  class PhysicalElement <<featureType>> {
    ' Ingen attributter
  }

  class Facility <<featureType>> {
    + facilityID [1] : ID
    + type [1] : CharacterString
    + status [1] : Status
    + footprint [0..1] : Geometry
  }

  class FacilityPart <<featureType>> {
    + facilityPartID [1] : ID
    + type [1] : FacilityPartType
    + status [1] : Status
    + footprint [0..1] : Geometry
    + alternative [0..1] : CharacterString
  }

  class Alignment <<featureType>> {
    + alignmentID [1] : ID
    + designAlternative [1] : CharacterString
    + purpose [0..1] : CharacterString
    + linestring2DRepresentation [0..1] : LineString
    + linestring3DRepresentation [0..1] : LineString
  }

  class Road <<featureType>> {
    + approximateWidth [0..1] : Length
  }

  class RoadElement <<featureType>> {
    + roadElementID [1] : ID
    + roadElementType [1] : RoadElementType
    + material [0..1] : CharacterString
  }

  class AnyFeature <<featureType>> {
    ' Ingen attributter
  }

  class AbstractFeature <<featureType>> {
    ' Ingen attributter
  }

  class Alignment <<featureType>> {
    + alignmentID [1] : ID
    + purpose [0..1] : CharacterString
    + designAltenrative [0..1] : CharacterString
    + linestring2DRepresentation [0..1] : LineString
    + linestring3DRepresentation [0..1] : LineString
  }

  class Referanselinje <<featureType>> {
    + norskeTillegg [0..1] : ReferanseLinjeNorskeTillegg
  }

  abstract class VegElement <<featureType>> {
    + fraProfil [0..1] : Real
    + tilProfil [0..1] : Real
    + norskeTillegg [0..1] : VegElementNorskeTillegg
  }

  class Veg <<featureType>> {
    + norskeTillegg [0..1] : VegNorskeTillegg
  }

  abstract class RoadElementN <<featureType>> {
    + roadElementID [1] : ID
    + material [0..1] : CharacterString
  }

  class Overbygningselement_for_Vegdesign <<featureType>> {
    + name [1] : CharacterString
    + lagtype [1] : OverbygningLagtype
    + lagnummer [1] : Integer
    + tykkelse [0..1] : Real
    + indreFyllingshelling [0..1] : Real
  }

  class VegdesignElement <<featureType>> {
    + vegDesign [1] : VegdesignRef
    + ytterkant [1] : Ytterkant
  }

  class Planum <<featureType>> {
    ' Ingen attributter
  }

  class Overbygning <<featureType>> {
    + lagtype [1] : OverbygningLagtype
    + lagnummer [1] : Integer
    + tykkelse [0..1] : Real
  }

  abstract class VegkroppElement <<featureType>> {
    ' Ingen attributter
  }

  class Underbygning <<featureType>> {
    + lagtype [1] : UnderbygningLagtype
    + lagnummer [1] : Integer
    + tykkelse [0..1] : Real
  }

  class "Sideområde" as Sideomr_de <<featureType>> {
    ' Ingen attributter
  }

  class GenerelleEgenskaper <<featureType>> {
    + identifikasjon [1] : Identifikasjon
    + navn [0..1] : CharacterString
    + beskrivelse [0..1] : CharacterString
  }

  class Vegkropp <<featureType>> {
    ' Ingen attributter
  }

  class Veg_Prosjektreferanse <<featureType>> {
    + norskeTillegg [0..1] : VegNorskeTillegg
  }

  class StringLineN_Planum <<featureType>> {
    + vegdesignRef [0..1] : VegdesignRef
  }

  class StringLineN_Referanselinje <<featureType>> {
    ' Ingen attributter
  }

  class StringLineN_Underbygning <<featureType>> {
    + lagtype [1] : UnderbygningLagtype
    + vegdesignRef [0..1] : VegdesignRef
  }

  class StringLineN <<featureType>> {
    + geometri [1] : GM_Curve
  }

  class "StringLineN_Sideområde" as StringLineN_Sideomr_de <<featureType>> {
    + vegdesignRef [0..1] : VegdesignRef
  }

  class StringLineN_Overbygning <<featureType>> {
    + lagtype [1] : OverbygningLagtype
    + vegdesignRef [0..1] : VegdesignRef
  }

  class VegdesignElement_for_Vegkropp <<featureType>> {
    + vegDesign [1] : VegdesignRef
  }

  class Planum <<featureType>> {
    ' Ingen attributter
  }

  abstract class VegKroppElement <<featureType>> {
    + norskeTillegg [0..1] : VegElementNorskeTillegg
  }

  class Underbygning <<featureType>> {
    + lagtype [1] : UnderbygningLagtype
    + lagnummer [1] : Integer
    + tykkelse [0..1] : Real
  }

  class Overbygning <<featureType>> {
    + lagtype [1] : OverbygningLagtype
    + lagnummer [1] : Integer
    + tykkelse [0..1] : Real
  }

  class "Sideområde" as Sideomr_de <<featureType>> {
    ' Ingen attributter
  }

  class Terrengflate <<featureType>> {
    + geometri [1] : GM_Tin
  }

  class AlignmentSet <<external>> {
    ' definert i en annen modell
  }

  class CrossSection <<external>> {
    ' definert i en annen modell
  }

  class Element <<external>> {
    ' definert i en annen modell
  }

  class Property <<external>> {
    ' definert i en annen modell
  }

  class PropertySet <<external>> {
    ' definert i en annen modell
  }

  class Railway <<external>> {
    ' definert i en annen modell
  }

  class RoadElementSet <<external>> {
    ' definert i en annen modell
  }

  class StringLineSet <<external>> {
    ' definert i en annen modell
  }

  class SuperelevationEvent <<external>> {
    ' definert i en annen modell
  }

  class TemplateLocation <<external>> {
    ' definert i en annen modell
  }

  class ReferanseLinjeNorskeTillegg <<dataType>> {
    + tilhørerProsjekt [0..1] : Prosjektreferanse
  }

  class Prosjektreferanse <<dataType>> {
    + oppdragsgiverNavn [1] : CharacterString
    + oppdragsgiversOrganisasjonsnummer [0..1] : CharacterString
    + prosjektnavn [1] : CharacterString
    + prosjektID [1] : CharacterString
    + prosjektfase [0..1] : CharacterString
    + fasestatus [0..1] : CharacterString
    + levertAvOrganisasjon [1] : CharacterString
    + utarbeidetAv [1] : CharacterString
    + prosjektURL [0..1] : CharacterString
    + leveransedato [1] : Date
  }

  class VegElementNorskeTillegg <<dataType>> {
    + tilhørerProsjekt [0..1] : Prosjektreferanse
    + komponentreferanse [0..*] : Komponentreferanse
  }

  class Komponentreferanse <<dataType>> {
    + komponentkodesystem [1] : Komponentkodesystem
    + kodesystemversjon [1] : CharacterString
    + komponentkodeverdi [1] : CharacterString
  }

  class VegNorskeTillegg <<dataType>> {
    + tilhørerProsjekt [0..1] : Prosjektreferanse
    + komponentReferanse [0..*] : Komponentreferanse
    + dimensjonerendeParametre [0..1] : DimensjonerendeVerdier_Veg
    + totalOverbygningstykkelse [0..1] : Real
  }

  class DimensjonerendeVerdier_Veg <<dataType>> {
    + standardklasseVegstandard [1] : Dimensjoneringsklasse
    + hastighet [1] : DimensjonerendeHastighet
    + vegbredde [1] : DimensjonerendeVegbredde
    + motorkjøretøy [1] : DimensjonerendeMotorkjøretøy
    + trafikkmengdeÅDT [1] : DimensjonerendeTrafikkmengdeÅDT
    + kjøremåte [1] : DimensjonerendeKjøremåte
    + maxOverhøydeProsent [1] : MaxOverhøydeProsent
    + trafikk [1] : DimensjonerendeTrafikkgruppe
  }

  class VegdesignRef <<dataType>> {
    + flatetype [1] : VegdesignElementType
    + flaterekkefølge [1] : Integer
    + vegside [1] : Side
  }

  class Identifikasjon <<dataType>> {
    + lokalId [1] : CharacterString
    + navnerom [1] : CharacterString
    + versjonId [0..1] : CharacterString
  }

  class FacilityPartRelationship {
  }

  class StringLine {
  }

  class LinearElement {
  }

  class AlignmentCurve {
  }

  class YtreFlatekant {
  }

  class Volumobjekt {
  }

  class ToppOverflate {
  }
}

  AnyFeature <|-- Feature
  Feature --> PropertySet : propertySet [0..*]
  Feature --> PropertySet : propertySet [0..*]
  Feature --> Property : property [0..*]
  Feature --> Property : property [0..*]
  Feature <|-- PhysicalElement
  PhysicalElement --> PhysicalElement : part [0..*]
  PhysicalElement --> PhysicalElement : partOf [0..1]
  Feature <|-- Facility
  Feature <|-- FacilityPart
  FacilityPart --> Facility
  FacilityPart --> FacilityPartRelationship : relationship [0..*]
  Feature <|-- Alignment
  FacilityPart <|-- Road
  Road --> Alignment : alignment [0..*]
  Road --> RoadElementSet : roadElementSet [0..*]
  Road --> StringLine : stringLine [0..*]
  Road --> StringLineSet : stringLineSet [0..*]
  Road --> CrossSection : crossSection [0..*]
  Road --> RoadElement : element [0..*]
  PhysicalElement <|-- RoadElement
  RoadElement --> LinearElement : locatedAlong [0..1]
  RoadElement --> RoadElementSet
  Feature <|-- AbstractFeature
  AbstractFeature --> AbstractFeature : part [0..*]
  AbstractFeature --> AbstractFeature : partOf [0..1]
  Alignment --> AlignmentCurve : geometry [0..1]
  Alignment <|-- Referanselinje
  RoadElementN <|-- VegElement
  Road <|-- Veg
  Veg --> Referanselinje : referanselinje [0..*]
  Veg --> VegElement : element [0..*]
  PhysicalElement <|-- RoadElementN
  VegElement <|-- VegdesignElement
  VegdesignElement --> Overbygningselement_for_Vegdesign : overbygning [0..*]
  VegdesignElement --> Underbygning : underbygning [0..*]
  VegdesignElement --> Planum : planum [0..*]
  VegkroppElement <|-- Planum
  Planum --> YtreFlatekant : venstreSide [0..1]
  Planum --> YtreFlatekant : høyreSide [0..1]
  VegkroppElement <|-- Overbygning
  Overbygning --> VegdesignElement : vegdesignElement [0..1]
  VegElement <|-- VegkroppElement
  VegkroppElement --> Volumobjekt : volum [0..1]
  VegkroppElement --> ToppOverflate : toppOverflate [0..1]
  VegkroppElement --> YtreFlatekant : ytterkant [0..1]
  VegkroppElement <|-- Underbygning
  VegkroppElement <|-- Sideomr_de
  Sideomr_de --> VegdesignElement : vegdesignElement [0..1]
  GenerelleEgenskaper <|-- Vegkropp
  Vegkropp --> VegKroppElement : vegkroppElement [0..*]
  GenerelleEgenskaper <|-- Veg_Prosjektreferanse
  Veg_Prosjektreferanse --> Vegkropp : vegelementsamling [0..*]
  Veg_Prosjektreferanse --> VegKroppElement : element [0..*]
  Veg_Prosjektreferanse --> StringLineN : stringLine [0..*]
  StringLineN <|-- StringLineN_Planum
  StringLineN <|-- StringLineN_Referanselinje
  StringLineN <|-- StringLineN_Underbygning
  GenerelleEgenskaper <|-- StringLineN
  StringLineN <|-- StringLineN_Sideomr_de
  StringLineN <|-- StringLineN_Overbygning
  GenerelleEgenskaper <|-- VegdesignElement_for_Vegkropp
  VegKroppElement <|-- Planum
  Planum --> YtreFlatekant : høyreSide [0..1]
  Planum --> YtreFlatekant : venstreSide [0..1]
  GenerelleEgenskaper <|-- VegKroppElement
  VegKroppElement --> ToppOverflate : toppOverflate [0..1]
  VegKroppElement --> YtreFlatekant : ytterkant [0..1]
  VegKroppElement --> Volumobjekt : volum [0..1]
  VegKroppElement <|-- Underbygning
  VegKroppElement <|-- Overbygning
  Overbygning --> VegdesignElement_for_Vegkropp : vegdesignElement [0..1]
  VegKroppElement <|-- Sideomr_de
  Sideomr_de --> VegdesignElement_for_Vegkropp : vegdesignElement [0..1]
  GenerelleEgenskaper <|-- Terrengflate
  AlignmentSet --> Alignment : alignment [1..*]
  AlignmentSet --> Alignment : alignment [1..*]
  Element --> FacilityPart
  Railway --> Alignment : alignment [0..*]
  SuperelevationEvent --> Alignment : locatedAlong [1]
  TemplateLocation --> Alignment : locatedAlong [1]

@enduml
